# Server-only: use a NEW Supabase project, separate from existing infrastructure.
SUPABASE_URL=
# Preferred server-only key from Supabase Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=
# Legacy compatibility only; leave empty when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=

# Phone Auth: leave disabled until the separate project, SQL and SMS provider are configured.
SMS_AUTH_ENABLED=false
# Supabase publishable (or legacy anon) key, NOT the service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Server-only, randomly generated at least 32 characters; do not use a proxy placeholder.
AUTH_RATE_LIMIT_SECRET=
# Must match Supabase's configured OTP code length (6 to 10 digits).
AUTH_OTP_LENGTH=6
# Public widget site key. Enable matching Turnstile CAPTCHA in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile's SECRET key belongs in Supabase Auth settings, never NEXT_PUBLIC_*.

# Staff workspace uses the same user-session connection and persistent limiter.
# Provision verified staff out-of-band; no ADMIN_EMAIL or metadata-based auto-promotion.
# Enable Email/Password, matching CAPTCHA and TOTP in the future selected test Auth service.
# Staff sign-in does not depend on SMS_AUTH_ENABLED.

# Enable only after migration 013, Auth and application privacy/retention review in the selected test project.
CLIENT_APPLICATIONS_ENABLED=false

# Optional isolation acceptance entry. Ignored unless VERCEL_ENV is exactly preview.
# It still requires verified Auth email/password, Turnstile, rate limiting and one approved company.
CLIENT_EMAIL_TEST_LOGIN_ENABLED=false
# Exactly two distinct Auth user UUIDs, comma-separated. Never staff/admin UUIDs.
CLIENT_EMAIL_TEST_USER_IDS=
